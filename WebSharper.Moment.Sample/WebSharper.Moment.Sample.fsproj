<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <OutputType>Library</OutputType>
    <WebSharperSourceMap>false</WebSharperSourceMap>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Client.fs" />
    <None Include="package.json" />
    <None Include="esbuild.config.mjs" />
    <None Include="entry.mjs" />
    <None Include="wsconfig.json" />
    <Content Include="index.html" />
    <Content Include="site.css" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WebSharper.Moment\WebSharper.Moment.fsproj" />
  </ItemGroup>

  <Target Name="ESBuildBundle" AfterTargets="WebSharperCompile">
    <Exec Command="npm install" />
    <Exec Command="node ./esbuild.config.mjs" />
  </Target>

  <Import Project="..\paket-files\wsbuild\github.com\dotnet-websharper\build-script\WebSharper.Fake.targets" Condition="Exists('..\paket-files\wsbuild\github.com\dotnet-websharper\build-script\WebSharper.Fake.targets')" />
  <Import Project="..\.paket\Paket.Restore.targets" />

</Project>
